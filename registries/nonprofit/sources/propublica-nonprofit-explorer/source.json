  "guidance": {
    "best_for": [
      "Finding an organization's EIN and every filing year",
      "Headline revenue, expenses, assets and contributions by tax year",
      "latest_object_id, the key to the full IRS XML return"
    ],
    "query_shapes": [
      {
        "task": "EIN from a name",
        "access": "api",
        "endpoint": "org-search",
        "recipe": "q=<name>; check city/state and NTEE (A69 = symphony orchestras) before trusting a hit.",
        "example": "--param q=\"Berkeley Symphony\""
      },
      {
        "task": "financial history",
        "access": "api",
        "endpoint": "organization",
        "recipe": "ein=<digits>; filings_with_data[] newest first; tax_prd_yr is the year the fiscal year STARTED (tax_prd 202307 = FY Jul 2023–Jun 2024).",
        "example": "--param ein=237219508"
      }
    ],
    "pitfalls": [
      "No employee or volunteer counts: those are in the full return (Part I lines 5-6); take latest_object_id to the IRS e-file XML (990 data lake).",
      "The XML download and the full-filing pages sit behind a bot check (HTTP 403 'Security Check'); never try to get around it. Use the 990 data lake for the XML.",
      "filings_with_data lags the filings by a year or more; filings_without_data lists newer returns that only have a PDF.",
      "formtype: 0 = 990, 1 = 990-EZ, 2 = 990-PF.",
      "Figures are the IRS SOI extract's, which can differ from the return after amendments; cite the return (EIN, tax period, object id)."
    ],
    "llm_notes": "",
    "routing": {
      "discovery": "preferred",
      "citation": "follow_primary",
      "quantitative_claims": "acceptable"
    },
    "resolution": {
      "strategy": "source_of_record",
      "notes": "Cite the filed Form 990 (EIN, tax period, object id); ProPublica is where it was found."
    }
  },
